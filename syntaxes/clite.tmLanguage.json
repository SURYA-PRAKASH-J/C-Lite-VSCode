
{
  "scopeName": "source.clite",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.clite",
          "match": "//.*$"
        },
        {
          "name": "comment.block.clite",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.clite",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.clite",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.clite",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.clite",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.language.boolean.clite",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.clite",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.clite",
          "match": "\\b(if|else|while)\\b"
        },
        {
          "name": "keyword.output.clite",
          "match": "\\b(echo|endl)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.clite",
          "match": "\\b(int|bool|char|string)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.clite",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.clite",
          "match": "==|!=|<=|>=|&&|\\|\\||[+*/%=<>!\\-]"
        }
      ]
    }
  }
}
